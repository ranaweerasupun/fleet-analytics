# .env.example
# Copy this to .env and fill in your values
# The .env file is gitignored — never commit it
#
# These are for local development (docker-compose stack): 

INFLUX_USERNAME=admin
INFLUX_PASSWORD=your_password_here
INFLUX_TOKEN=your_token_here
INFLUX_ORG=fleet-org
INFLUX_BUCKET=fleet-telemetry
INFLUX_URL=http://localhost:8086

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_password_here

# For InfluxDB Cloud (Pi Zero 2W / production setup):
# INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com
# INFLUX_TOKEN=your_cloud_token_here